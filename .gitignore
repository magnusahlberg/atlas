# Ignore everything by default.
# Only files explicitly unignored below are version controlled.
/*
/.*

# ── Core system files ────────────────────────────────────────────────────────
!/.gitignore
!/AGENTS.md
!/CLAUDE.md
!/README.md
!/LICENSE
!/CONTRIBUTING.md
!/.mcp.json

# ── Shared workflows and scripts ─────────────────────────────────────────────
!/.atlas/
!/.atlas/**

# ── Claude Code config ───────────────────────────────────────────────────────
!/.claude/
!/.claude/**
/.claude/settings.local.json
/.claude/worktrees/

# ── Notes folder placeholder ─────────────────────────────────────────────────
!/notes/
/notes/*
!/notes/.gitkeep

# ── Wiki and Sources placeholders ────────────────────────────────────────────
!/Wiki/
/Wiki/*
!/Wiki/.gitkeep
!/Sources/
/Sources/*
!/Sources/.gitkeep

# ── Never ────────────────────────────────────────────────────────────────────
.DS_Store
